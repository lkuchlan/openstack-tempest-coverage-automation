#!/bin/bash
# Pre-commit hook for OpenStack Tempest test standards
# Runs Python-based checks on staged test files
#
# Installation:
#   ./hooks/install-hooks.sh
#
# Usage:
#   Automatically runs on `git commit`
#   Bypass (not recommended): git commit --no-verify

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Find staged Python test files
STAGED_TEST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'test_.*\.py$' || true)

if [ -z "$STAGED_TEST_FILES" ]; then
    # No test files staged, skip checks
    exit 0
fi

echo -e "${BLUE}🔍 Checking OpenStack Tempest test standards...${NC}"
echo ""

# Determine checks directory location
# Try local .git/hooks/checks first, then fall back to repo hooks/checks
if [ -d "$(dirname "$0")/checks" ]; then
    CHECKS_DIR="$(dirname "$0")/checks"
elif [ -d "hooks/checks" ]; then
    CHECKS_DIR="hooks/checks"
else
    echo -e "${RED}❌ Error: Cannot find checks directory${NC}"
    echo "   Expected: .git/hooks/checks or hooks/checks"
    exit 1
fi

FAILED=0
TOTAL_FILES=0
CHECKED_FILES=0

# Count total files
for test_file in $STAGED_TEST_FILES; do
    if [ -f "$test_file" ]; then
        TOTAL_FILES=$((TOTAL_FILES + 1))
    fi
done

echo -e "${BLUE}Found $TOTAL_FILES test file(s) to check${NC}"
echo ""

# Run checks on each file
for test_file in $STAGED_TEST_FILES; do
    if [ ! -f "$test_file" ]; then
        continue
    fi

    CHECKED_FILES=$((CHECKED_FILES + 1))
    echo -e "${BLUE}[$CHECKED_FILES/$TOTAL_FILES]${NC} Checking: ${YELLOW}$test_file${NC}"

    # Check 1: Imports (no raw API usage)
    if [ -f "$CHECKS_DIR/check-tempest-imports.py" ]; then
        if ! python3 "$CHECKS_DIR/check-tempest-imports.py" "$test_file"; then
            FAILED=1
        fi
    fi

    # Check 2: Base classes
    if [ -f "$CHECKS_DIR/check-base-classes.py" ]; then
        if ! python3 "$CHECKS_DIR/check-base-classes.py" "$test_file"; then
            FAILED=1
        fi
    fi

    # Check 3: Waiters (no sleep)
    if [ -f "$CHECKS_DIR/check-waiters.py" ]; then
        if ! python3 "$CHECKS_DIR/check-waiters.py" "$test_file"; then
            FAILED=1
        fi
    fi

    # Check 4: Cleanup patterns
    if [ -f "$CHECKS_DIR/check-cleanup.py" ]; then
        if ! python3 "$CHECKS_DIR/check-cleanup.py" "$test_file"; then
            FAILED=1
        fi
    fi

    echo ""
done

if [ $FAILED -eq 1 ]; then
    echo ""
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}❌ Tempest standards violations found!${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "${YELLOW}Please fix the issues above and commit again.${NC}"
    echo ""
    echo -e "${BLUE}Reference:${NC} https://docs.openstack.org/tempest/latest/HACKING.html"
    echo ""
    echo -e "${YELLOW}To bypass (NOT RECOMMENDED):${NC} git commit --no-verify"
    echo ""
    exit 1
fi

echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ All Tempest standards checks passed!${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
exit 0
