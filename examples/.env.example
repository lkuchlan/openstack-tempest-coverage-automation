# ====================================
# Jira MCP Server Configuration
# ====================================
# Copy this file to your project root as .env and fill in your actual values
#
# SECURITY WARNING: NEVER commit .env to git!
# The .env file is git-ignored for your protection.
#
# Setup Steps:
# 1. Copy this file: cp examples/.env.example .env
# 2. Edit .env with your actual credentials
# 3. Secure the file: chmod 600 .env
# 4. Verify it's ignored: git status (should not show .env)

# ====================================
# Jira Instance Configuration
# ====================================
# Your Jira instance URL (no trailing slash)
# Example: https://issues.redhat.com
# Example: https://your-company.atlassian.net
JIRA_URL=https://your-jira-instance.com

# ====================================
# Jira Authentication
# ====================================
# For Jira Cloud: Use your email + API token
# For Jira Data Center/Server: Use username + password or personal access token

# Your Jira username or email
# Example: your.email@company.com
JIRA_USERNAME=your-email@company.com

# Your Jira API token or password
#
# How to generate Jira API token:
# 1. Jira Cloud: https://id.atlassian.com/manage-profile/security/api-tokens
# 2. Jira Data Center: User Settings → Personal Access Tokens
# 3. Copy the generated token here
#
# Example: abc123def456ghi789jkl012mno345pqr
JIRA_API_TOKEN=your-api-token-here

# ====================================
# Optional: Project Configuration
# ====================================
# Uncomment and set if your Tempest repositories are not in default locations

# Path to your Tempest workspace
# Default: ~/tempest-workspace
# PROJECT_ROOT=/path/to/your/tempest/workspace

# ====================================
# Alternative: System Environment Variables
# ====================================
# Instead of using .env file, you can set system-wide environment variables:
#
# Add to ~/.zshrc or ~/.bashrc:
# export JIRA_URL="https://your-jira.com"
# export JIRA_USERNAME="your-email@company.com"
# export JIRA_API_TOKEN="your-token"
#
# Then: source ~/.zshrc

# ====================================
# Fallback: Manual Input
# ====================================
# If you don't set up Jira MCP, the skills still work!
# You'll provide ticket details manually when prompted:
# - Ticket ID
# - Summary
# - Description
# - Requirements
#
# Same quality implementation, just without automatic Jira fetching.

# ====================================
# DevStack VM Configuration
# ====================================
# Required for the /verify-tempest-devstack skill
# Set these to your DevStack VM's connection details

# VM hostname or IP address
DEVSTACK_HOST=your-devstack-vm-ip

# SSH username (must have sudo access)
DEVSTACK_USER=ubuntu

# Path to SSH private key for the VM
DEVSTACK_SSH_KEY=~/.ssh/devstack_key

# DevStack service passwords
DEVSTACK_ADMIN_PASSWORD=secretadmin
DEVSTACK_DB_PASSWORD=secretdb
DEVSTACK_RABBIT_PASSWORD=secretrabbit
DEVSTACK_SERVICE_PASSWORD=secretservice

# ====================================
# Security Best Practices
# ====================================
# ✅ DO:
# - Keep .env file secure (chmod 600)
# - Rotate API tokens regularly
# - Use least-privilege accounts
# - Never share .env file
#
# ❌ DON'T:
# - Commit .env to git
# - Share API tokens in chat/email
# - Use admin accounts for automation
# - Store credentials in code
